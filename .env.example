# RAG Memory Playground — environment template
#
# Copy to .env.local and fill in the keys for the providers you want to
# promote to "real". Missing keys cause the container to fall back to the
# deterministic stub for that provider role (and surface the fallback as a
# failure mode in the ExplainableRun).
#
# Set FRAMEWORK_MODE=real to attempt real providers. Default is local (all stubs).

FRAMEWORK_MODE=local

# OpenAI — powers both LlamaIndex.TS embeddings and OpenAI chat completions.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Evaluation: set EVAL_MODE=judge for real LLM-as-judge scoring (needs real mode
# + OPENAI_API_KEY). Default = deterministic Ragas-shaped stub. Judge falls back
# to deterministic on error or after EVAL_DAILY_MAX_CALLS (default 200) per day.
EVAL_MODE=
EVAL_DAILY_MAX_CALLS=200

# Mem0 — persistent memory across runs.
MEM0_API_KEY=
MEM0_ORG_ID=
MEM0_PROJECT_ID=

# Langfuse — trace upload + UI.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Postgres + pgvector — memory-block/edge persistence. Unset = in-memory store.
# Apply schema: psql "$DATABASE_URL" -f supabase/migrations/0001_memory.sql
DATABASE_URL=

# Local dev only: allow the Settings UI to write keys to .env.local. Leave unset
# in any shared/public deployment (the config/connect POST routes return 403).
ALLOW_RUNTIME_CONFIG=
